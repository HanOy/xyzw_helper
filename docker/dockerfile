# ============================================================
# 构建期 npm 源: 默认走国内镜像
#
# 背景: 实测 NAS 直连 registry.npmjs.org 只有 17~20 KiB/s。而 `pnpm prune --prod`
# 也会重新下载 tarball (已实测确认, 不是纯删除), 所以慢的不只是 install ——
# 那一步实测 384s。
#
# 为什么写进项目 .npmrc, 而不是别的写法 (三种都在 pnpm 10.19.0 上实测过):
#   - 命令行 --registry=...        : `pnpm prune` 报 "Unknown option: 'registry'" 直接失败
#   - 环境变量 npm_config_registry : pnpm 11 起被忽略 (10 认), 升级后会静默失效
#   - 项目 .npmrc 的 registry=     : install / prune 都读, 跨版本稳定   <-- 选它
#
# ⚠️ 追加时**必须前置换行符** (`printf '\nregistry=...'`)。
#    踩过的坑: server-deps 会先 COPY 仓库里的 server/.npmrc, 而该文件末尾没有换行,
#    直接 `printf 'registry=...' >>` 会粘成一行 `side-effects-cache=trueregistry=...`,
#    registry 根本没设上 —— 但命令不报错, 表现为「web-deps 走了镜像(132s)、
#    server-deps/server-builder 没走(prune 824s)」这种半生效的诡异现象。
#
# 两个 lockfile 都只含 integrity 哈希、无绝对 tarball URL, 换源不会改变拉到的内容,
# 与 --frozen-lockfile 兼容。
#
# 关闭换源(回到官方源): docker compose build --build-arg NPM_REGISTRY=
# 改默认值请同时改下面 web-deps / server-deps 两处。
# ============================================================

# --- Stage 1: install frontend deps ---
FROM node:20-bookworm-slim AS web-deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml* ./
# ARG 刻意放在 apt 层之后: 任何插在 apt 之前的新指令都会让它缓存失效,
# 那一层要装 build-essential (约 200MB, 官方源直连要 1000s+)。
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.19.0 --activate && \
    if [ -n "$NPM_REGISTRY" ]; then printf '\nregistry=%s\n' "$NPM_REGISTRY" >> .npmrc; fi && \
    pnpm install --frozen-lockfile

# --- Stage 2: build frontend (only source files, no node_modules) ---
FROM web-deps AS web-builder
WORKDIR /app

COPY index.html ./
COPY public ./public
COPY src ./src
COPY vite.config.js tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY uno.config.ts eslint.config.ts components.d.ts ./

RUN pnpm run build

# --- Stage 3: install server deps (clean) ---
FROM node:20-bookworm-slim AS server-deps
WORKDIR /app/server
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
COPY server/package.json server/pnpm-lock.yaml* ./
COPY server/.npmrc ./.npmrc
COPY server/pnpm-workspace.yaml ./pnpm-workspace.yaml
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.19.0 --activate && \
    if [ -n "$NPM_REGISTRY" ]; then printf '\nregistry=%s\n' "$NPM_REGISTRY" >> .npmrc; fi && \
    pnpm install --frozen-lockfile

# --- Stage 4: build server (only source files) ---
# 这里不用再传 registry: server-deps 写下的 /app/server/.npmrc 随文件系统继承下来,
# `pnpm prune --prod` 会读它 —— 前提是上面那行 registry 真的写对了 (见文件头 ⚠️)。
FROM server-deps AS server-builder
WORKDIR /app/server
COPY server/tsconfig.json ./tsconfig.json
COPY server/src ./src
RUN pnpm run build && \
    pnpm prune --prod

# --- Stage 5: runtime ---
FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8787
ENV XYZW_STATIC_DIR=/app/web

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && rm -rf /var/lib/apt/lists/* && \
    corepack enable && corepack prepare pnpm@10.19.0 --activate

COPY --from=web-builder /app/dist /app/web
# --chown 在 COPY 时直接落成 node 属主: 避免事后 `chown -R /app` 把整个
# node_modules (几万个文件) 逐个 copy-up 进新层 —— 那样这一步要跑几分钟,
# 且镜像里 node_modules 会被完整复制两份。
COPY --from=server-builder --chown=node:node /app/server/dist /app/server/dist
COPY --from=server-builder --chown=node:node /app/server/package.json /app/server/package.json
COPY --from=server-builder --chown=node:node /app/server/node_modules /app/server/node_modules

WORKDIR /app/server
# node 只需要写 SQLite 数据目录; 其余文件 root 属主 + 默认 644/755 权限,
# node 用户本就能读, 无需递归 chmod。只 chown 这一个目录, 毫秒级完成。
RUN mkdir -p /app/server/data && chown node:node /app/server/data
USER node

EXPOSE 8787

CMD ["node", "dist/index.js"]
