# 必填: 首次启动的密码, 容器首次启动需要这个来派生 AES 主密钥
# 之后会写入 ./data/.session-key, 重启不再需要
XYZW_BOOT_PASSWORD=change-me-to-something-strong

# 必填: 用于加密磁盘上的主密钥, 生产环境务必替换
XYZW_SESSION_PASSPHRASE=change-me-on-deploy

# 可选
# PORT=8787
# HOST=0.0.0.0

# ---- 构建期镜像源 (可选, 一般不用动) ----
# docker-compose.yml 里已经默认指向国内源, 不写这两行也是快的。
# 只在需要时覆盖: 比如换个源, 或者置空改回官方源 (APT_MIRROR= / NPM_REGISTRY=)。
#   APT_MIRROR   : 只写域名, 不带 http://
#                  可选值 mirrors.cloud.tencent.com / mirrors.aliyun.com / mirrors.tuna.tsinghua.edu.cn
#   NPM_REGISTRY : 完整 URL
# APT_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
