# XYZW Server 配置示例
# 复制为 .env 后修改

# 启动密码 (首次启动时需要; 设置后免去交互式输入)
XYZW_BOOT_PASSWORD=

# 用于加密磁盘上的主密钥 (生产务必替换为强密码)
XYZW_SESSION_PASSPHRASE=change-me-on-deploy

# 监听
PORT=8787
HOST=127.0.0.1

# 数据目录 (存放 SQLite + 加密密钥)
XYZW_DATA_DIR=./data

# 静态资源 (可选, 生产时可指向 ../dist 由前端 build 输出)
XYZW_STATIC_DIR=

# 游戏服 WS 地址
XYZW_WS_URL=wss://comb-platform.hortorgames.com

# 连接池参数
XYZW_MAX_CONN=10
XYZW_CONN_INTERVAL_MS=500

# JWT 有效期
XYZW_JWT_TTL=7d

# 日志
LOG_LEVEL=info